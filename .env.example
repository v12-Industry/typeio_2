# Copy to .env at the repo root: `cp .env.example .env`.
#
# .env itself is gitignored, so a fresh clone or git worktree has none.
# Config.App, Config.Db and Config.Web read these; every key below is
# required unless marked otherwise, and the server refuses to start
# without them.
#
# The values here are the local-development defaults, and match what CI
# sets as job environment variables. Change DB_PASS if your Postgres
# wants something else.

ENV=Development

# --- Database ---
# make run-postgres starts a container using these, so DB_USER/DB_PASS/
# DB_DATABASE/DB_PORT are what the container is created with as well as
# what the app connects with -- change them together or not at all.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_DATABASE=project
DB_SCHEMA=project
# Validated to be between 1 and 10.
DB_POOL_COUNT=10

# --- Web ---
# WEB_PORT is the one optional key: it defaults to 3000
# (Config.Web.defaultWebPort) when unset.
WEB_PORT=3000
WEB_INDEX_REDIRECT=/ui/projects/vw
WEB_REDIRECT_PATH=/api/nodes
WEB_REQUEST_ID_HEADER=X-Request-ID

# There is deliberately no GRAPH_VISUALIZATION key. Which dependency-graph
# drawing renders is a property of the request (?visualizationMode=), not
# of the process -- see docs/architecture/visualization-switching.md.
