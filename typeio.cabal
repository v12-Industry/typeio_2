    build-depends:
      aeson
      , base ^>=4.18.3.0
      , bytestring
      , case-insensitive
      , containers
      , unordered-containers
      , dotenv
      , esqueleto
      , fast-logger
      , gitrev
      , http-api-data
      , http-media
      , http-types
      , lucid2
      , monad-logger
      , mtl
      , persistent
      , persistent-postgresql
      , postgresql-simple
      , resource-pool
      , servant
      , servant-server
      , transformers-either
      , text
      , time
      , transformers
      , unliftio-core
      , uuid
      , wai
      , wai-middleware-static
      , warp
    hs-source-dirs:   lib/src
    default-language: Haskell2010

executable server
    import:           warnings
    -- Warp needs the threaded RTS for its per-connection timeout-manager
    -- machinery (GHC.Event.Thread.getSystemTimerManager) -- without
    -- -threaded, the compiled binary links against the non-threaded RTS,
    -- starts and accepts connections, but crashes handling every single
    -- request. Nothing in CI or the unit/integration suites starts this
    -- executable and sends it a real HTTP request over a socket, so
    -- dropping -threaded would not be caught by any of them.
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    main-is:          Main.hs
    build-depends:
      base ^>=4.18.3.0
      , src
    hs-source-dirs:   exe/server
    default-language: Haskell2010

test-suite spec
    import:             warnings
    type:               exitcode-stdio-1.0
    main-is:            Spec.hs
    hs-source-dirs:     test
    other-modules:
      App.LinkSpec
      , App.MiddlewareSpec
      , App.ParamsSpec
      , Common.EitherSpec
      , Common.ValidationSpec
      , Common.Web.QuerySpec
      , Config.AppSpec
      , Config.DbSpec
      , Config.VisualizationSpec
      , Config.WebSpec
      , Data.Text.UtilSpec
      , Domain.Project.Graph.CoordSpec
      , Domain.Project.Graph.LayerSpec
      , Domain.Project.Graph.LayoutSpec
      , Domain.Project.Graph.OrderSpec
      , Domain.Project.Graph.RouteSpec
      , Domain.Project.Node.StatusSpec
      , Domain.Project.Orbit.LayoutSpec
      , Domain.Project.Orbit.UnfoldSpec
      , Domain.Project.StatsSpec
      , Platform.BuildSpec
    build-tool-depends: hspec-discover:hspec-discover
    build-depends:
      base ^>=4.18.3.0
      , src
      , aeson
      , http-api-data
      , persistent
      , bytestring
      , case-insensitive
      , containers
      , hspec
      , http-types
      , mtl
      , QuickCheck
      , text
      , wai-middleware-static
    default-language:   Haskell2010

-- Separate from `spec` on purpose (docs/solution-proposals/integration-testing.md
-- §7): these tests need Docker (via testcontainers) and a real, migrated
-- Postgres, so they're a distinct, slower `cabal test integration` target
-- rather than something that runs every time plain `cabal test` does.
test-suite integration
    import:             warnings
    type:               exitcode-stdio-1.0
    main-is:            Spec.hs
    hs-source-dirs:     test-integration
    other-modules:
      Integration.Support
      , Domain.Central.Responder.Api.SeedSpec
      , Domain.Project.Responder.Api.Node.PostSpec
      , Domain.Project.Responder.Ui.ProjectCreate.SubmitSpec
      , Domain.Project.Responder.Ui.ProjectManage.Node.CreateSpec
      , Domain.Project.Responder.Ui.ProjectManage.Node.DescriptionSpec
      , Domain.Project.Responder.Ui.ProjectManage.Node.StatusSpec
      , Domain.Project.Responder.Ui.ProjectManage.Node.TitleSpec
      , Domain.Project.Responder.Ui.ProjectManage.SaveStateSpec
      , Domain.Project.Responder.Ui.ProjectManage.StatsSpec
      , Domain.Project.Responder.Ui.ProjectManage.ViewSpec
      , Domain.Project.Visualization.CommonSpec
      , Domain.Project.Visualization.Orbital.ResponderSpec
      , Domain.Project.Visualization.Rootless.ResponderSpec
    build-tool-depends: hspec-discover:hspec-discover
    build-depends:
      base ^>=4.18.3.0
      , src
      , bytestring
      , directory
      , http-types
      , hspec
      , mtl
      , persistent
      , testcontainers
      , text
      , time
      , wai
      , wai-extra
    default-language:   Haskell2010
