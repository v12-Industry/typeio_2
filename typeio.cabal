cabal-version:      3.0
name:               typeio 
version:            0.1.0.0
-- synopsis:
-- description:
license:            NONE
license-file:       LICENSE
author:             jordanstorz
maintainer:         jm.storz@gmail.com
-- copyright:
category:           Web
build-type:         Simple
-- extra-source-files:

common warnings
    ghc-options: -Wall

executable server
    import:           warnings
    -- Warp needs the threaded RTS for its per-connection timeout-manager
    -- machinery (GHC.Event.Thread.getSystemTimerManager) -- without
    -- -threaded, the compiled binary links against the non-threaded RTS,
    -- starts and accepts connections, but crashes handling every single
    -- request. See #110 for how this went unnoticed: nothing in CI or
    -- the unit/integration suites actually starts this executable and
    -- sends it a real HTTP request over a socket.
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:    
      base ^>=4.18.3.0
      , src 
    hs-source-dirs:   exe/server
    default-language: Haskell2010

library src 
    import:
      warnings
    exposed-modules:
      Platform.Web
      -- Exposed so `test-suite spec` can import it, same as the modules
      -- below: a test-suite only sees a library's exposed-modules.
      , Platform.Build
      , Common.Validation
      , Config.App
      , Config.Db
      , Config.Visualization
      , Config.Web
      , Data.Either
      , Data.HashTree
      , Data.Text.Util
      -- Exposed (rather than other-modules) specifically so the
      -- `integration` test-suite can import them -- a cabal test-suite
      -- only sees a library's exposed-modules, never its other-modules
      -- (see CLAUDE.md's notes on this from the unit-testing rollout).
      , Domain.Central.Responder.Api.Seed
      -- The graph layout engine is exposed so `test-suite spec` can
      -- import it: a test-suite only sees a library's exposed-modules.
      , Domain.Project.Graph.Containment
      , Domain.Project.Graph.Coord
      , Domain.Project.Graph.Layer
      , Domain.Project.Graph.Layout
      , Domain.Project.Graph.Order
      , Domain.Project.Graph.Route
      , Domain.Project.Graph.Types
      , Domain.Project.Model
      -- The orbital visualization's own geometry, exposed for the same
      -- reason: it is pure and dependency-free, so `test-suite spec`
      -- covers it. Deliberately not under Graph.*, which is the layered
      -- engine (#229).
      , Domain.Project.Orbit.Layout
      , Domain.Project.Orbit.Types
      , Domain.Project.Orbit.Unfold
      , Domain.Project.Responder.Api.Node.Post
      , Domain.Project.Responder.Ui.ProjectCreate.Submit
      -- Exposed for `test-suite integration`'s GraphSpec, which asserts
      -- on the SVG this renders (#178).
      , Domain.Project.Visualization.Common
      -- Exposed for the switch's own integration spec (#223), so it
      -- exercises the real `renderFor` table rather than a copy that
      -- could drift from it.
      , Domain.Project.Responder.Ui.Container
      , Domain.Project.Visualization.Layered.Responder
      , Domain.Project.Visualization.Orbital.Responder
      , Domain.Project.Visualization.Orbital.View
      , Domain.Project.Visualization.Rootless.Responder
      , Domain.Project.Responder.Ui.ProjectManage.Node.Description
      , Domain.Project.Responder.Ui.ProjectManage.Node.Status
      , Domain.Project.Responder.Ui.ProjectManage.Node.Title
      , Environment.Db
    other-modules:
      Common.Web.Attributes
      , Common.Web.Elements
      , Common.Web.Query
      , Common.Web.Template.MainHeader
      , Container.Build
      , Container.Root
      , Domain.Central.Container
      , Domain.Central.Responder.Ui.Empty
      , Domain.Central.Responder.Ui.IndexView
      , Domain.Central.Responder.Ui.Container
      , Domain.Central.Responder.Api.Container
      , Domain.Central.Middleware.IndexRender
      , Domain.Project.Container
      , Domain.Project.Responder.Api.Node.Get
      , Domain.Project.Responder.Api.NodeStatus.Get
      , Domain.Project.Responder.Api.NodeType.Get
      , Domain.Project.Responder.Api.Project.Get
      , Domain.Project.Responder.Api.Container
      , Domain.Project.Responder.Ui.ProjectManage.Link
      , Domain.Project.Responder.Ui.ProjectManage.Node
      , Domain.Project.Responder.Ui.ProjectManage.Node.Detail
      , Domain.Project.Responder.Ui.ProjectManage.Node.Edit
      , Domain.Project.Responder.Ui.ProjectManage.Node.Query
      , Domain.Project.Responder.Ui.ProjectManage.Node.Refresh
      , Domain.Project.Responder.Ui.ProjectManage.Node.Validation
      , Domain.Project.Responder.Ui.ProjectManage.View
      , Domain.Project.Responder.Ui.ProjectCreate.View
      , Domain.Project.Responder.Ui.ProjectIndex.List
      , Domain.Project.Responder.Ui.ProjectIndex.View
      , Domain.System.Container
      , Domain.System.Middleware.Container
      , Domain.System.Responder.Container
      , Domain.System.Responder.Config
      , Domain.System.Middleware.RequestId
      , Domain.System.Middleware.Logging.Common
      , Domain.System.Middleware.Logging.Request
      , Domain.System.Middleware.Logging.Response
      , Logging.Core
      , Logging.Database
      , Environment.Env
      , Environment.Logging
      , Platform.Web.Router
      , Platform.Web.Middleware
    other-extensions:
      OverloadedStrings
    build-depends:    
      aeson 
      , base ^>=4.18.3.0
      , bytestring
      , case-insensitive
      , clay
      , containers
      , dotenv
      , esqueleto
      , fast-logger
      , gitrev
      , hashable
      , http-types
      , lucid2
      , lucid-svg
      , mtl
      , monad-logger
      , network-uri 
      , persistent
      , persistent-postgresql
      , persistent-template
      , postgresql-simple
      , resource-pool
      , time
      , text
      , transformers
      , transformers-base
      , transformers-either
      , unliftio-core
      , unordered-containers
      , uuid
      , wai
      , wai-extra
      , wai-middleware-static
      , wai-util
      , warp
    hs-source-dirs:   lib/src
    default-language: Haskell2010

test-suite spec
    import:             warnings
    type:               exitcode-stdio-1.0
    main-is:            Spec.hs
    hs-source-dirs:     test
    other-modules:
      Common.ValidationSpec
      , Config.AppSpec
      , Config.DbSpec
      , Config.WebSpec
      , Data.EitherSpec
      , Data.HashTreeSpec
      , Data.Text.UtilSpec
      , Domain.Project.Graph.ContainmentSpec
      , Domain.Project.Graph.CoordSpec
      , Domain.Project.Graph.LayerSpec
      , Domain.Project.Graph.LayoutSpec
      , Domain.Project.Graph.OrderSpec
      , Domain.Project.Graph.RouteSpec
      , Domain.Project.Orbit.LayoutSpec
      , Domain.Project.Orbit.UnfoldSpec
      , Platform.BuildSpec
    build-tool-depends: hspec-discover:hspec-discover
    build-depends:
      base ^>=4.18.3.0
      , src
      , aeson
      , bytestring
      , case-insensitive
      , hashable
      , containers
      , hspec
      , mtl
      , QuickCheck
      , text
    default-language:   Haskell2010

-- Separate from `spec` on purpose (docs/solution-proposals/integration-testing.md
-- §7): these tests need Docker (via testcontainers) and a real, migrated
-- Postgres, so they're a distinct, slower `cabal test integration` target
-- rather than something that runs every time plain `cabal test` does.
test-suite integration
    import:             warnings
    type:               exitcode-stdio-1.0
    main-is:            Spec.hs
    hs-source-dirs:     test-integration
    other-modules:
      Integration.Support
      , Domain.Central.Responder.Api.SeedSpec
      , Domain.Project.Responder.Api.Node.PostSpec
      , Domain.Project.Responder.Ui.ProjectCreate.SubmitSpec
      , Domain.Project.Responder.Ui.ProjectManage.GraphSpec
      , Domain.Project.Responder.Ui.ProjectManage.Node.DescriptionSpec
      , Domain.Project.Responder.Ui.ProjectManage.Node.StatusSpec
      , Domain.Project.Responder.Ui.ProjectManage.Node.TitleSpec
      , Domain.Project.Visualization.CommonSpec
      , Domain.Project.Visualization.Orbital.ResponderSpec
      , Domain.Project.Visualization.Rootless.ResponderSpec
    build-tool-depends: hspec-discover:hspec-discover
    build-depends:
      base ^>=4.18.3.0
      , src
      , bytestring
      , directory
      , http-types
      , hspec
      , mtl
      , persistent
      , testcontainers
      , text
      , time
      , transformers
      , wai
      , wai-extra
    default-language:   Haskell2010
